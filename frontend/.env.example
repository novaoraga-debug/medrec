# MedRec unified frontend configuration (Vite).
# Copy to .env and adjust. Every value is optional — the app works with defaults.

# Backend API base URL. Leave empty to auto-detect http://localhost:4000 in dev.
VITE_API_URL=

# Google OAuth 2.0 Client ID (must match backend GOOGLE_CLIENT_ID).
# Leave empty to show the disabled "not configured" Google button.
VITE_GOOGLE_CLIENT_ID=

# Code that reveals the hidden Staff/Admin card on the sign-in screen.
# Set per environment; when unset the built-in dev default is used.
VITE_STAFF_UNLOCK_CODE=
