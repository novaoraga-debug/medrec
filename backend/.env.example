# MedRec backend configuration
# Copy to .env and fill in real values.

# Server
PORT=4000

# Auth secrets — generate long random strings in production.
JWT_SECRET=replace-me-dev-secret
REFRESH_SECRET=replace-me-dev-refresh
QR_SECRET=replace-me-qr-secret

# Google Sign-In (OAuth 2.0 Client ID, "Web application" type).
# When set, the portals enable the real Google button and /api/auth/providers
# reports google.enabled = true. Leave empty to keep Google sign-in hidden.
GOOGLE_CLIENT_ID=

# Optional webhook notified on repeated admin login failures.
ADMIN_ALERT_WEBHOOK_URL=

# Key used to encrypt sensitive fields at rest.
SENSITIVE_KEY=medrec-dev-sensitive-key

# How long minted file tokens (?file_token= on GET /api/files/:filename) stay
# valid. Any duration string jsonwebtoken accepts (e.g. 5m, 10m, 1h).
FILE_TOKEN_TTL=5m

# Refresh-token rotation: maximum live refresh tokens kept per account. Expired
# entries are pruned automatically.
MEDREC_MAX_REFRESH_TOKENS=10

# CORS allowlist for deployed frontends/portals (comma separated origins).
# Outside production every http://localhost:* origin is additionally accepted so
# the four role portals keep working on their own dev ports.
# Example: CORS_ORIGINS=https://app.medrec.example,https://portal.medrec.example
CORS_ORIGINS=
